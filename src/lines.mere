// src/lines.mere — where the lines are, without holding the file.
//
// One scan at open time, in pages, and what survives is a Vec of byte offsets:
// `starts[i]` is where line i begins. For a 208 MB / 2.6M-line file that is a
// 20 MB index over a file never loaded.
//
// TWO RULES THIS FILE EXISTS TO OBEY, both measured:
//
//   1. The page is read with `file_pread_bytes`, not `file_pread`. The Vec[int]
//      version boxes every byte -- eight bytes per byte, built one fgetc at a
//      time. 208 MB took 3.64 s at 10.1 MB peak RSS that way; this way it is
//      0.36 s at 1.8 MB.
//
//   2. Each page is scanned INSIDE a `region` block, so the page's bytes are
//      freed before the next one is read. The index itself is built into a Vec
//      created OUTSIDE the block -- it is meant to outlive the scan, and ints
//      are not region-allocated, so pushing out of the block is sound.
//
// The scan is a plain byte loop. SIMD was measured and is not worth it here:
// clang vectorises the scalar loop well enough that 335 MB of newline counting
// takes 50 ms, which is not where the time goes.

module Lines {

  // 256 KiB: small enough that the page never dominates the footprint, large
  // enough that the per-page region block costs nothing next to the read.
  let page_size = 262144;

  // Scan one page of bytes, pushing the offset of every byte AFTER a newline.
  // `base` is the page's offset in the file, so what lands in the index is a
  // file offset rather than a page offset.
  let rec _scan_page = fn (starts: Vec[R, int]) -> fn (b: bytes) ->
                       fn (i: int) -> fn (n: int) -> fn (base: int) ->
    if i >= n then ()
    else
      let _ = if bytes_get b i == 10 then vec_push starts (base + i + 1) else () in
      _scan_page starts b (i + 1) n base;

  // Walk the whole origin once. `starts` is filled in order.
  let rec _scan = fn (o: origin) -> fn (starts: Vec[R, int]) ->
                  fn (off: int) -> fn (total: int) ->
    if off >= total then ()
    else
      let want = if off + page_size > total then total - off else page_size in
      // The page lives and dies inside this block; only ints leave it.
      let _ = region P {
        let s = Buffer.origin_slice o off want in
        let b = bytes_of_str s in
        _scan_page starts b 0 (bytes_len b) off
      } in
      _scan o starts (off + want) total;

  // The index for an origin. Line 0 starts at 0 always, even for an empty file
  // -- an empty document has one (empty) line, which is what a cursor needs.
  let index_of = fn (o: origin) ->
    let starts = vec_new () in
    let _ = vec_push starts 0 in
    let total = Buffer.origin_len o in
    let _ = _scan o starts 0 total in
    starts;

  let count = fn (starts: Vec[R, int]) -> vec_len starts;

  let start_of = fn (starts: Vec[R, int]) -> fn (line: int) ->
    let n = vec_len starts in
    if line <= 0 then 0
    else if line >= n then vec_get starts (n - 1)
    else vec_get starts line;

  // Where line `line` ends, exclusive of its newline: the next line's start
  // minus one, or the end of the document for the last line.
  let end_of = fn (starts: Vec[R, int]) -> fn (line: int) -> fn (total: int) ->
    let n = vec_len starts in
    if line + 1 >= n then total
    else
      let nxt = vec_get starts (line + 1) in
      if nxt > 0 then nxt - 1 else 0;

  // Which line a byte offset falls on. Binary search, because the cursor asks
  // this on every keystroke and the index has millions of entries.
  let line_at = fn (starts: Vec[R, int]) -> fn (off: int) ->
    let rec go = fn (lo: int) -> fn (hi: int) ->
      if lo >= hi then lo
      else
        let mid = (lo + hi + 1) / 2 in
        if vec_get starts mid <= off then go mid hi else go lo (mid - 1)
    in
    if off <= 0 then 0 else go 0 (vec_len starts - 1);
}
