// src/search.mere — literal search that never materialises the document.
//
// The editor can open a file it cannot hold, so the search has to page through
// the piece table the same way the line index does: a window at a time, inside
// a `region` block, with only an integer coming out. Measured on 208 MB, the
// whole file scans in 0.46 s at 2.3 MB of resident memory -- about 450 MB/s,
// which is fast enough that "find next" is instant and a whole-file miss is
// noticeable but not painful.
//
// TWO THINGS THIS HAS TO GET RIGHT and a naive version does not:
//
//   1. A MATCH THAT STRADDLES A WINDOW BOUNDARY. Each window reads
//      `page + needle_len - 1` bytes but advances by `page`, so any match is
//      wholly inside some window. Without the overlap a search silently misses
//      the needle exactly when it lands on a 256 KiB boundary -- which is the
//      kind of bug that looks like "it just didn't find it".
//
//   2. THE WINDOW MUST BE LARGER THAN THE NEEDLE. A needle longer than the
//      page would never fit in a window and would never be found. The window
//      grows to fit instead of the search failing quietly.
//
// Literal only. `contrib/regex` is a backtracking ASCII MVP and is neither fast
// enough for a file this size nor correct for the text this editor draws.

module Search {

  // 256 KiB, the same window the line index uses. Large enough that the
  // per-window region costs nothing next to the read.
  let page = 262144;

  // The last byte offset at which `needle` could start and still fit.
  let _last_start = fn (total: int) -> fn (nlen: int) -> total - nlen;

  // Forward from `from` (inclusive). -1 when there is no match at or after it.
  let rec _fwd = fn (b: buf) -> fn (total: int) -> fn (nlen: int) ->
                 fn (needle: str) -> fn (at: int) ->
    if at > _last_start total nlen then (0 - 1)
    else
      // Read one window, plus enough to complete a match that starts in it.
      let span = page + nlen - 1 in
      let want = if at + span > total then total - at else span in
      let hit = region W {
        let s = Buffer.slice b at want in
        str_index_of s needle
      } in
      if hit >= 0 then at + hit
      else _fwd b total nlen needle (at + page);

  // `from` is where to start looking, inclusive.
  let forward = fn (b: buf) -> fn (total: int) -> fn (from: int) -> fn (needle: str) ->
    let nlen = str_len needle in
    if nlen <= 0 || nlen > total then (0 - 1)
    else _fwd b total nlen needle (if from < 0 then 0 else from);

  // Backward from `before` (exclusive), returning the LAST match strictly
  // before it. Windows are walked from the end, and inside a window the last
  // occurrence is taken -- `str_index_of` only finds the first, so this steps
  // forward through the window keeping the latest hit.
  let rec _last_in = fn (s: str) -> fn (needle: str) -> fn (from: int) -> fn (best: int) ->
    let rest = substring s from (str_len s) in
    let hit = str_index_of rest needle in
    if hit < 0 then best
    else _last_in s needle (from + hit + 1) (from + hit);

  let rec _back = fn (b: buf) -> fn (total: int) -> fn (nlen: int) ->
                  fn (needle: str) -> fn (win_start: int) -> fn (before: int) ->
    if win_start < 0 then (0 - 1)
    else
      let span = page + nlen - 1 in
      let want = if win_start + span > total then total - win_start else span in
      let hit = region W {
        let s = Buffer.slice b win_start want in
        // Only matches that START before `before` count.
        let limit = before - win_start in
        let cut = if limit < str_len s then limit else str_len s in
        if cut <= 0 then (0 - 1) else _last_in (substring s 0 cut) needle 0 (0 - 1)
      } in
      if hit >= 0 then win_start + hit
      else _back b total nlen needle (win_start - page) before;

  let backward = fn (b: buf) -> fn (total: int) -> fn (before: int) -> fn (needle: str) ->
    let nlen = str_len needle in
    if nlen <= 0 || nlen > total then (0 - 1)
    else
      let cap = if before > total then total else before in
      // Start from the window containing the last possible match start.
      let last = cap - 1 in
      if last < 0 then (0 - 1)
      else _back b total nlen needle ((last / page) * page) cap;

  // What the editor actually calls: search from the cursor, and if nothing is
  // found, WRAP. Returns (offset, wrapped) so the editor can say so -- an
  // editor that silently wraps makes you think the file is shorter than it is.
  let find_next = fn (b: buf) -> fn (total: int) -> fn (from: int) -> fn (needle: str) ->
    let hit = forward b total from needle in
    if hit >= 0 then (hit, false)
    else
      let w = forward b total 0 needle in
      (w, w >= 0);

  let find_prev = fn (b: buf) -> fn (total: int) -> fn (before: int) -> fn (needle: str) ->
    let hit = backward b total before needle in
    if hit >= 0 then (hit, false)
    else
      let w = backward b total total needle in
      (w, w >= 0);
}
