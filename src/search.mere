// src/search.mere — literal search that never materialises the document.
//
// The editor can open a file it cannot hold, so the search has to page through
// the piece table the same way the line index does: a window at a time, inside
// a `region` block, with only an integer coming out. Measured on 208 MB, the
// whole file scans in 0.46 s at 2.3 MB of resident memory -- about 450 MB/s,
// which is fast enough that "find next" is instant and a whole-file miss is
// noticeable but not painful.
//
// TWO THINGS THIS HAS TO GET RIGHT and a naive version does not:
//
//   1. A MATCH THAT STRADDLES A WINDOW BOUNDARY. Each window reads
//      `page + needle_len - 1` bytes but advances by `page`, so any match is
//      wholly inside some window. Without the overlap a search silently misses
//      the needle exactly when it lands on a 256 KiB boundary -- which is the
//      kind of bug that looks like "it just didn't find it".
//
//   2. THE WINDOW MUST BE LARGER THAN THE NEEDLE. A needle longer than the
//      page would never fit in a window and would never be found. The window
//      grows to fit instead of the search failing quietly.
//
// Literal only. `contrib/regex` is a backtracking ASCII MVP and is neither fast
// enough for a file this size nor correct for the text this editor draws.

module Search {

  // 256 KiB, the same window the line index uses. Large enough that the
  // per-window region costs nothing next to the read.
  let page = 262144;

  // The last byte offset at which `needle` could start and still fit.
  let _last_start = fn (total: int) -> fn (nlen: int) -> total - nlen;

  // Forward from `from` (inclusive), considering starts up to `stop`
  // (inclusive). -1 when there is no match in that span.
  //
  // `stop` exists for the WRAP. Without it, a search that finds nothing reads
  // the file twice: once from the cursor to the end, and once from the
  // beginning to the end again. Measured on 1 GB that was 278 ms for a failed
  // search against 141 ms for the one pass it actually needs.
  // Returns (offset, windows read). THE COUNT IS NOT DEBUG OUTPUT: bounding
  // the wrap does not change any ANSWER, only how much is read, so a test that
  // compares offsets cannot tell a bounded wrap from an unbounded one. The
  // count is the only thing that can, which makes it part of the contract.
  let rec _fwd = fn (b: buf) -> fn (total: int) -> fn (nlen: int) ->
                 fn (needle: str) -> fn (stop: int) -> fn (at: int) ->
                 fn (seen: int) ->
    if at > stop then ((0 - 1), seen)
    else
      // Read one window, plus enough to complete a match that starts in it.
      let span = page + nlen - 1 in
      let want = if at + span > total then total - at else span in
      let hit = region W {
        let s = Buffer.slice b at want in
        str_index_of s needle
      } in
      // A hit is only a hit if it STARTS within the span asked for: the window
      // reads past `stop` so a match straddling it can be completed, and a
      // wrap that accepted one of those would report a match it was told not
      // to look at -- and then report it as found at the wrong end of the file.
      if hit >= 0 && at + hit <= stop then (at + hit, seen + 1)
      else if hit >= 0 then ((0 - 1), seen + 1)
      else _fwd b total nlen needle stop (at + page) (seen + 1);

  // `from` is where to start looking, inclusive.
  let forward_counted = fn (b: buf) -> fn (total: int) -> fn (from: int) ->
                        fn (needle: str) ->
    let nlen = str_len needle in
    if nlen <= 0 || nlen > total then ((0 - 1), 0)
    else _fwd b total nlen needle (_last_start total nlen)
           (if from < 0 then 0 else from) 0;

  let forward = fn (b: buf) -> fn (total: int) -> fn (from: int) -> fn (needle: str) ->
    fst (forward_counted b total from needle);

  // Forward, but only over starts in [from, stop]. Used by the wrap.
  let forward_upto_counted = fn (b: buf) -> fn (total: int) -> fn (from: int) ->
                             fn (stop: int) -> fn (needle: str) ->
    let nlen = str_len needle in
    if nlen <= 0 || nlen > total then ((0 - 1), 0)
    else
      let cap = _last_start total nlen in
      _fwd b total nlen needle (if stop > cap then cap else stop)
        (if from < 0 then 0 else from) 0;

  let forward_upto = fn (b: buf) -> fn (total: int) -> fn (from: int) ->
                     fn (stop: int) -> fn (needle: str) ->
    fst (forward_upto_counted b total from stop needle);

  // Backward from `before` (exclusive), returning the LAST match strictly
  // before it. Windows are walked from the end, and inside a window the last
  // occurrence is taken -- `str_index_of` only finds the first, so this steps
  // forward through the window keeping the latest hit.
  let rec _last_in = fn (s: str) -> fn (needle: str) -> fn (from: int) -> fn (best: int) ->
    let rest = substring s from (str_len s) in
    let hit = str_index_of rest needle in
    if hit < 0 then best
    else _last_in s needle (from + hit + 1) (from + hit);

  // `floor` is the lowest start this walk will accept, for the same reason
  // `stop` exists in the forward one: the wrap must not re-read what the first
  // pass has already been through.
  let rec _back = fn (b: buf) -> fn (total: int) -> fn (nlen: int) ->
                  fn (needle: str) -> fn (win_start: int) -> fn (before: int) ->
                  fn (floor: int) -> fn (seen: int) ->
    if win_start < 0 || win_start + page <= floor then ((0 - 1), seen)
    else
      let span = page + nlen - 1 in
      let want = if win_start + span > total then total - win_start else span in
      let hit = region W {
        let s = Buffer.slice b win_start want in
        // Only matches that START before `before` count.
        let limit = before - win_start in
        let cut = if limit < str_len s then limit else str_len s in
        // ...and not before `floor`.
        let lo = if floor > win_start then floor - win_start else 0 in
        if cut <= lo then (0 - 1) else _last_in (substring s 0 cut) needle lo (0 - 1)
      } in
      if hit >= 0 then (win_start + hit, seen + 1)
      else _back b total nlen needle (win_start - page) before floor (seen + 1);

  // The last match starting in [floor, before). Public because `floor` has a
  // meaning of its own and because it is the only way to see that the floor is
  // enforced INSIDE a window as well as between them: reached through
  // `find_prev` the two are indistinguishable, since the wrap's floor is only
  // ever the point a failed pass has already cleared.
  let backward_from_counted = fn (b: buf) -> fn (total: int) -> fn (floor: int) ->
                               fn (before: int) -> fn (needle: str) ->
    let nlen = str_len needle in
    if nlen <= 0 || nlen > total then ((0 - 1), 0)
    else
      let cap = if before > total then total else before in
      // Start from the window containing the last possible match start.
      let last = cap - 1 in
      if last < 0 then ((0 - 1), 0)
      else _back b total nlen needle ((last / page) * page) cap floor 0;

  let backward_from = fn (b: buf) -> fn (total: int) -> fn (floor: int) ->
                      fn (before: int) -> fn (needle: str) ->
    fst (backward_from_counted b total floor before needle);

  // Backward over the whole file, which is what a plain "find previous" wants.
  let backward = fn (b: buf) -> fn (total: int) -> fn (before: int) -> fn (needle: str) ->
    backward_from b total 0 before needle;

  // What the editor actually calls: search from the cursor, and if nothing is
  // found, WRAP. Returns (offset, wrapped) so the editor can say so -- an
  // editor that silently wraps makes you think the file is shorter than it is.
  // (offset, wrapped, windows read). `find_next` drops the count.
  let find_next_counted = fn (b: buf) -> fn (total: int) -> fn (from: int) ->
                          fn (needle: str) ->
    let r = forward_counted b total from needle in
    if fst r >= 0 then ((fst r, false), snd r)
    else
      let w = forward_upto_counted b total 0 (from - 1) needle in
      ((fst w, fst w >= 0), snd r + snd w);

  let find_next = fn (b: buf) -> fn (total: int) -> fn (from: int) -> fn (needle: str) ->
    let hit = forward b total from needle in
    if hit >= 0 then (hit, false)
    else
      // The wrap covers only what the first pass did not: starts BEFORE
      // `from`. A match that begins before it and reaches past it is in that
      // set and is found; one that begins at or after it was already looked
      // for and is not there.
      let w = forward_upto b total 0 (from - 1) needle in
      (w, w >= 0);

  let find_prev_counted = fn (b: buf) -> fn (total: int) -> fn (before: int) ->
                          fn (needle: str) ->
    let r = backward_from_counted b total 0 before needle in
    if fst r >= 0 then ((fst r, false), snd r)
    else
      let w = backward_from_counted b total before total needle in
      ((fst w, fst w >= 0), snd r + snd w);

  let find_prev = fn (b: buf) -> fn (total: int) -> fn (before: int) -> fn (needle: str) ->
    let hit = backward b total before needle in
    if hit >= 0 then (hit, false)
    else
      // Same bound as the forward wrap, the other way round: the first pass
      // covered starts below `before`, so the wrap covers only those at or
      // above it.
      let w = backward_from b total before total needle in
      (w, w >= 0);
}
