// src/lsp.mere — a language-server client, over one file descriptor.
//
// `mere lsp` speaks Content-Length-framed JSON-RPC on stdin and stdout, like
// every other language server. The interesting part is not the protocol; it is
// that Mere needed NOTHING NEW to talk to one.
//
// A socketpair gives the child a single bidirectional fd (shim/medit2_shim.c),
// and at that point the server looks exactly like an accepted TCP connection.
// `tcp_read` and `tcp_write` are read(2) and write(2) rather than recv/send, so
// they work on it unchanged; `io_poll_add` takes any fd, so the editor waits on
// the keyboard and the server in the same poll(2). No compiler change, no new
// builtin, no second thread.
//
// WHAT THIS DELIBERATELY DOES NOT DO. `mere lsp` advertises
// `textDocumentSync: 1`, full-text sync: every change sends the whole buffer.
// That is fine for source files and wrong for the large files this editor is
// built to open, so the editor attaches a server only to small ones. Making it
// incremental is a change to the server, not to this client.

import "mere-json/json.mere";

// The monotonic clock, used only to give up on an unanswered request. Declared
// here rather than in the editor because the timeout belongs to the protocol:
// nothing else in medit2 cares what time it is.
extern fn now_ms: unit -> int;

// What a reply is FOR. The protocol correlates a response to a request by id
// and says nothing about what the client wanted it for, so the client has to
// remember -- and remembering "an id is outstanding" is not enough, because
// the answer to `hover` and the answer to `definition` are both a JSON object
// and are handled completely differently.
type want = WInit | WHover | WDefinition | WComplete | WFormat | WTokens | WNone;

// One entry of a `textDocument/formatting` reply. Positions are the protocol's
// zero-based (line, character); turning them into buffer offsets is the
// editor's job, since only it has the line index.
type tedit = { sl: int, sc: int, el: int, ec: int, text: str };

// The answer, already parsed into the shape the editor draws. A variant rather
// than a bag of optional fields: `hover` and `definition` both come back as a
// JSON object, and holding "a string AND a position AND a list" would let the
// editor read a field the current reply never filled in.
type answer =
  | ANone
  | AHover of str
  | ADef of (str * int * int)     // uri, line, character -- all zero-based
  | ACompl of str list
  | AEdits of tedit list
  // Semantic tokens, DELTA-DECODED into absolute numbers, four per token:
  // line, character, length, kind. A flat list rather than a list of records
  // because that is the shape the protocol sends and the shape the renderer
  // indexes; giving each quadruple a name would cost an allocation per token
  // on a file that has thousands.
  | ATokens of int list;

type lsp = {
  fd: int,
  pending: str,     // bytes read but not yet a complete frame
  version: int,     // didChange revision, which the protocol requires to grow
  diag: str,        // the first diagnostic, as a line for the status bar
  ndiag: int,
  alive: bool,
  // The id of the request in flight and what it was for. ONE at a time: an
  // editor asks in response to a keystroke, and a second question before the
  // first is answered means the first answer is already stale. A table of
  // outstanding requests would be the general thing and would buy nothing
  // here -- and every entry in it would be an answer nobody is still waiting
  // for.
  req_id: int,
  req_want: want,
  // When it went out, so an unanswered request can be given up on. A server
  // that never replies must not leave the editor waiting for a keystroke it
  // will never get an answer to -- and `mere lsp` type-checks the file to
  // answer a hover, so "slow" is a normal state, not a broken one.
  req_at: int,
  // What came back, for the editor to draw. Cleared when a new request goes out
  // so a stale answer cannot be shown beside a new question.
  answer: answer,
  note: str,        // "" or a one-line status, e.g. a timeout
  // The semantic-token type names, in the order the server numbered them.
  // It comes from the initialize reply: a token's "kind" is an INDEX into this
  // list and means nothing without it, so hard-coding the order would be
  // hard-coding one server's build.
  legend: str list,
};

module Lsp {

  let crlf = chr 13 ++ chr 10;

  // --- JSON string escaping ------------------------------------------------
  // The document's own text goes into a JSON string, so every quote, backslash
  // and control character in it has to survive the trip. A missing case here
  // desynchronises the server from the buffer silently -- it keeps answering,
  // about the wrong text.
  let _esc_char = fn (c: str) ->
    let b = ord c in
    if b == 34 then "\\\""
    else if b == 92 then "\\\\"
    else if b == 10 then "\\n"
    else if b == 13 then "\\r"
    else if b == 9 then "\\t"
    else if b < 32 then
      // \u00XX, spelled out: there is no printf here and two hex digits is all
      // a C0 control needs.
      let hex = "0123456789abcdef" in
      "\\u00" ++ substring hex (b / 16) (b / 16 + 1) ++ substring hex (b % 16) (b % 16 + 1)
    else c;

  let rec _esc_go = fn (cs: str list) -> fn (acc: str) ->
    match cs with
    | Nil -> acc
    | Cons (c, rest) -> _esc_go rest (acc ++ _esc_char c);

  // Walks BYTES, not code points: a multi-byte character's continuation bytes
  // are all >= 0x80, so they fall through `_esc_char` unchanged and the UTF-8
  // is passed through as-is, which is what JSON wants.
  let rec _bytes_of = fn (s: str) -> fn (i: int) -> fn (acc: str list) ->
    if i < 0 then acc else _bytes_of s (i - 1) (Cons (substring s i (i + 1), acc));

  let escape = fn (s: str) -> _esc_go (_bytes_of s (str_len s - 1) Nil) "";

  // --- framing -------------------------------------------------------------
  let frame = fn (body: str) ->
    "Content-Length: " ++ show (str_len body) ++ crlf ++ crlf ++ body;

  // --- the connection ------------------------------------------------------
  let connect = fn (fd: int) ->
    (lsp { fd = fd, pending = "", version = 1, diag = "", ndiag = 0,
           alive = fd >= 0, req_id = 0, req_want = WNone, req_at = 0,
           answer = ANone, note = "", legend = Nil } : lsp);

  let uri_of = fn (path: str) ->
    // The server resolves imports against this, so it has to be absolute.
    if str_starts_with path "/" then "file://" ++ path else "file://./" ++ path;

  // The three messages that have to arrive before a server will say anything:
  // initialize, initialized, didOpen. Sent as one write, because they are one
  // handshake and a server that gets them in pieces is a server waiting.
  // Returns the bytes AND the client state, because the initialize reply is a
  // response like any other: it carries id 1, and the client has to be
  // expecting it or the legend it brings is dropped as an uncorrelated answer.
  let hello = fn (st: lsp) -> fn (path: str) -> fn (text: str) ->
    let uri = uri_of path in
    let init = "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":"
            ++ "\{\"processId\":null,\"rootUri\":null,\"capabilities\":\{}}}" in
    let inited = "\{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":\{}}" in
    let opened = "\{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":"
              ++ "\{\"textDocument\":\{\"uri\":\"" ++ uri ++ "\",\"languageId\":\"mere\","
              ++ "\"version\":1,\"text\":\"" ++ escape text ++ "\"}}}" in
    (frame init ++ frame inited ++ frame opened,
     ({ st | req_id = 1, req_want = WInit, req_at = now_ms () } : lsp));

  let change = fn (path: str) -> fn (v: int) -> fn (text: str) ->
    let uri = uri_of path in
    frame ("\{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":"
        ++ "\{\"textDocument\":\{\"uri\":\"" ++ uri ++ "\",\"version\":" ++ show v ++ "},"
        ++ "\"contentChanges\":[\{\"text\":\"" ++ escape text ++ "\"}]}}");

  // --- requests --------------------------------------------------------------
  // A position in the protocol is (line, character) ZERO-BASED, and `character`
  // counts UTF-16 code units. Converting the editor's byte offsets into those
  // units is the CALLER's job -- it is the one holding the text -- and this
  // file only spells the number into JSON.
  let _pos = fn (line: int) -> fn (ch: int) ->
    "\{\"line\":" ++ show line ++ ",\"character\":" ++ show ch ++ "}";

  let request = fn (st: lsp) -> fn (path: str) -> fn (method: str) ->
                fn (params_extra: str) -> fn (w: want) ->
    let id = st.req_id + 1 in
    let body = "\{\"jsonrpc\":\"2.0\",\"id\":" ++ show id
            ++ ",\"method\":\"" ++ method ++ "\",\"params\":\{"
            ++ "\"textDocument\":\{\"uri\":\"" ++ uri_of path ++ "\"}"
            ++ params_extra ++ "}}" in
    // The reply is cleared here and not when it arrives: a new question must
    // not leave the previous answer on screen beside it.
    (frame body, ({ st | req_id = id, req_want = w, req_at = now_ms (),
                         answer = ANone, note = "" } : lsp));

  let at_position = fn (line: int) -> fn (ch: int) ->
    ",\"position\":" ++ _pos line ch;

  let format_options =
    ",\"options\":\{\"tabSize\":2,\"insertSpaces\":true}";

  // --- reading -------------------------------------------------------------
  // One frame out of the pending buffer, if a whole one is there. Returns
  // (body, rest); an empty body means "not yet", which is the normal answer.
  let take_frame = fn (pending: str) ->
    let hdr_end = str_index_of pending (crlf ++ crlf) in
    if hdr_end < 0 then ("", pending)
    else
      let header = substring pending 0 hdr_end in
      let key = "Content-Length:" in
      let at = str_index_of header key in
      if at < 0 then ("", substring pending (hdr_end + 4) (str_len pending))
      else
        let after = str_trim (substring header (at + str_len key) (str_len header)) in
        // The header may carry more fields after the length; take the digits.
        let rec digits = fn (i: int) ->
          if i >= str_len after then i
          else if is_digit (char_at after i) then digits (i + 1) else i in
        let n = int_of_str (substring after 0 (digits 0)) in
        let body_start = hdr_end + 4 in
        if str_len pending < body_start + n then ("", pending)
        else (substring pending body_start (body_start + n),
              substring pending (body_start + n) (str_len pending));

  // --- diagnostics ---------------------------------------------------------
  let _field = fn (o: json) -> fn (k: str) ->
    match o with
    | JObj (fields) ->
      let rec go = fn (fs: (str * json) list) ->
        match fs with
        | Nil -> JNull
        | Cons (kv, rest) -> if str_eq (fst kv) k then snd kv else go rest
      in go fields
    | _ -> JNull;

  let _num = fn (v: json) -> match v with | JNum (n) -> n | _ -> 0;
  let _str = fn (v: json) -> match v with | JStr (s) -> s | _ -> "";

  let rec _len = fn (xs: json list) -> fn (acc: int) ->
    match xs with Nil -> acc | Cons (_, r) -> _len r (acc + 1);

  // Summarise publishDiagnostics into one status-bar line. The editor shows the
  // FIRST one and how many there are: a status bar cannot hold a list, and the
  // first error is the one that usually explains the rest.
  let apply_diagnostics = fn (st: lsp) -> fn (params: json) ->
    match _field params "diagnostics" with
    | JArr (ds) ->
      let n = _len ds 0 in
      if n == 0 then ({ st | diag = "", ndiag = 0 } : lsp)
      else
        // Parenthesised: an unbracketed `match` in an arm swallows the OUTER
        // wildcard arm below, and the error surfaces as "non-exhaustive" on
        // the outer match -- a long way from the cause.
        (match ds with
         | Cons (d, _) ->
           let rng = _field d "range" in
           let line = _num (_field (_field rng "start") "line") + 1 in
           let msg = _str (_field d "message") in
           let more = if n > 1 then "  (+" ++ show (n - 1) ++ ")" else "" in
           ({ st | diag = "L" ++ show line ++ ": " ++ msg ++ more, ndiag = n } : lsp)
         | Nil -> ({ st | diag = "", ndiag = 0 } : lsp))
    | _ -> st;

  // --- responses -----------------------------------------------------------
  // Each of these reads ONE shape, because the client asked one question. The
  // protocol makes almost every result a union (`Hover | null`,
  // `Location | Location[] | LocationLink[]`, `CompletionItem[] | CompletionList`)
  // so each parser takes both spellings and answers `ANone` for a null.

  let _first = fn (xs: json list) ->
    match xs with | Nil -> JNull | Cons (x, _) -> x;

  // Hover.contents: MarkupContent \{kind, value}, MarkedString (a bare string or
  // \{language, value}), or an array of MarkedString.
  let rec _hover_text = fn (v: json) ->
    match v with
    | JStr (s) -> s
    | JArr (xs) -> _hover_text (_first xs)
    | JObj (_) -> _str (_field v "value")
    | _ -> "";

  let _parse_hover = fn (result: json) ->
    let t = str_trim (_hover_text (_field result "contents")) in
    if str_eq t "" then ANone else AHover (t);

  let _loc_of = fn (v: json) ->
    // A LocationLink spells the target `targetUri`/`targetRange`; a Location
    // spells it `uri`/`range`. Taking whichever is present is shorter than
    // deciding which kind the server sent.
    let uri = let u = _str (_field v "uri") in
              if str_eq u "" then _str (_field v "targetUri") else u in
    let rng = let r = _field v "range" in
              (match r with | JNull -> _field v "targetSelectionRange" | _ -> r) in
    let rng2 = (match rng with | JNull -> _field v "targetRange" | _ -> rng) in
    let st_ = _field rng2 "start" in
    if str_eq uri "" then ANone
    else ADef ((uri, _num (_field st_ "line"), _num (_field st_ "character")));

  let _parse_def = fn (result: json) ->
    match result with
    | JArr (xs) -> (match _first xs with | JNull -> ANone | v -> _loc_of v)
    | JObj (_) -> _loc_of result
    | _ -> ANone;

  let rec _labels = fn (xs: json list) -> fn (acc: str list) ->
    match xs with
    | Nil -> list_rev acc
    | Cons (x, rest) ->
      let l = _str (_field x "label") in
      _labels rest (if str_eq l "" then acc else Cons (l, acc));

  let _parse_compl = fn (result: json) ->
    let xs = (match result with
              | JArr (a) -> a
              | JObj (_) -> (match _field result "items" with
                             | JArr (a) -> a
                             | _ -> Nil)
              | _ -> Nil) in
    let ls = _labels xs Nil in
    (match ls with | Nil -> ANone | _ -> ACompl (ls));

  let rec _edits = fn (xs: json list) -> fn (acc: tedit list) ->
    match xs with
    | Nil -> list_rev acc
    | Cons (x, rest) ->
      let r = _field x "range" in
      let a = _field r "start" in
      let z = _field r "end" in
      _edits rest (Cons ((tedit { sl = _num (_field a "line"), sc = _num (_field a "character"),
                                  el = _num (_field z "line"), ec = _num (_field z "character"),
                                  text = _str (_field x "newText") } : tedit), acc));

  // The legend, out of the initialize reply. A server that does not offer
  // semantic tokens leaves this empty and the editor simply never asks.
  let rec _strs = fn (xs: json list) -> fn (acc: str list) ->
    match xs with
    | Nil -> list_rev acc
    | Cons (x, r) -> _strs r (Cons (_str x, acc));

  let _parse_legend = fn (result: json) ->
    let prov = _field (_field result "capabilities") "semanticTokensProvider" in
    match _field (_field prov "legend") "tokenTypes" with
    | JArr (xs) -> _strs xs Nil
    | _ -> Nil;

  // The token stream is five integers per token and every one of them is a
  // DELTA: the line from the previous token's line, and the character from the
  // previous token's character WHEN THEY SHARE A LINE. Decoding it wrong paints
  // the file at an offset that grows, which looks like the highlighting
  // drifting rather than like a decoding bug.
  let rec _decode = fn (xs: json list) -> fn (line: int) -> fn (ch: int) ->
                    fn (acc: int list) ->
    match xs with
    | Cons (a, Cons (b, Cons (c, Cons (d, Cons (_, rest))))) ->
      let dl = _num a in
      let l2 = line + dl in
      let c2 = if dl == 0 then ch + _num b else _num b in
      _decode rest l2 c2 (Cons (_num d, Cons (_num c, Cons (c2, Cons (l2, acc)))))
    // Anything that is not a multiple of five is a stream this client cannot
    // read; stopping keeps what was decoded rather than guessing at the rest.
    | _ -> list_rev acc;

  let _parse_tokens = fn (result: json) ->
    match _field result "data" with
    | JArr (xs) -> (match _decode xs 0 0 Nil with | Nil -> ANone | ns -> ATokens (ns))
    | _ -> ANone;

  let _parse_edits = fn (result: json) ->
    match result with
    | JArr (xs) -> (match _edits xs Nil with | Nil -> ANone | es -> AEdits (es))
    | _ -> ANone;

  // A message with an `id` and no `method` is a response. It is only OUR
  // response if the id is the one in flight: a late reply to a question the
  // user has already moved on from carries the previous id, and applying it
  // would answer about the wrong position.
  let _response = fn (st: lsp) -> fn (v: json) ->
    let id = _num (_field v "id") in
    if id != st.req_id then st
    else
      let result = _field v "result" in
      (match _field v "error" with
       | JObj (_) ->
         ({ st | req_want = WNone, answer = ANone,
                 note = "lsp error: " ++ _str (_field (_field v "error") "message") } : lsp)
       | _ ->
         // The initialize reply is not an ANSWER -- nothing asked a question
         // the user is waiting for -- so it updates the legend and leaves the
         // answer empty rather than reporting "no answer" for a handshake.
         (match st.req_want with
          | WInit ->
            ({ st | req_want = WNone, answer = ANone, note = "",
                    legend = _parse_legend result } : lsp)
          | _ ->
            let a = (match st.req_want with
                     | WHover -> _parse_hover result
                     | WDefinition -> _parse_def result
                     | WComplete -> _parse_compl result
                     | WFormat -> _parse_edits result
                     | WTokens -> _parse_tokens result
                     | WInit -> ANone
                     | WNone -> ANone) in
            ({ st | req_want = WNone, answer = a,
                    note = (match a with | ANone -> "no answer" | _ -> "") } : lsp)));

  // Give up on a request the server never answered. Called from the editor's
  // poll loop, which already wakes on a timeout, so no extra timer is needed.
  let timeout_ms = 3000;

  let tick = fn (st: lsp) ->
    (match st.req_want with
     | WNone -> st
     | _ ->
       if now_ms () - st.req_at < timeout_ms then st
       else ({ st | req_want = WNone, answer = ANone, note = "lsp: no answer" } : lsp));

  let handle = fn (st: lsp) -> fn (body: str) ->
    // try_or, because a server is allowed to send something this client has no
    // parser for, and an editor that dies on an unexpected notification is
    // worse than one that ignores it.
    try_or (fn () ->
      let v = Json.parse_json body in
      let m = _str (_field v "method") in
      if str_eq m "textDocument/publishDiagnostics"
      then apply_diagnostics st (_field v "params")
      // No method means it is a response -- and a REQUEST from the server (it
      // would have both) is not something this client answers.
      else if str_eq m "" then _response st v
      else st) st;

  let rec _drain = fn (st: lsp) ->
    let taken = take_frame st.pending in
    let body = fst taken in
    if str_eq body "" then st
    else _drain (handle ({ st | pending = snd taken } : lsp) body);

  // Called with whatever came off the fd. Splitting "read the socket" from
  // "consume frames" is what lets the editor own the read (it already has the
  // arena and the poll set) and this file own the protocol.
  let feed = fn (st: lsp) -> fn (chunk: str) ->
    _drain ({ st | pending = st.pending ++ chunk } : lsp);

  let status = fn (st: lsp) ->
    if not st.alive then ""
    else if st.ndiag == 0 then "lsp ok"
    else st.diag;
}
